# Copy to .env. Nothing here is required: without it the pipeline writes a
# SQLite file next to the code, which is what the demo and the test suite use.

# --- storage ---------------------------------------------------------------
# An explicit URL wins over every DB_* variable below.
# DATABASE_URL=sqlite:////absolute/path/to/vbd_cdm.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/vbd_cdm
SQL_LITE_DB_NAME=vbd_cdm.db

# Used only when DATABASE_URL is unset. All five must be present.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# --- geography -------------------------------------------------------------
# The GADM file country resolution and boundary alignment read. Required for
# any coordinate -> country or coordinate -> admin-unit decision; without it
# those decisions return nothing rather than guessing.
VBD_ADMIN_BOUNDARIES=vocabularies/gadm41_KEN.gpkg